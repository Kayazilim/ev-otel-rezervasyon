{
    "name": "ogrenci/ev-otel-rezervasyon",
    "description": "Otel / Kiralık Ev Rezervasyon Sistemi - PHP 8.2, katmanlı mimari (Aşama 2: JSON depo)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-fileinfo": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "php -S localhost:8000 -t public public/index.php"
        ],
        "seed": "php bin/seed.php --force",
        "gorev": "php bin/gorev.php",
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "phpunit"
        ],
        "test:hizli": "phpunit --exclude-group eszamanlilik",
        "analiz": "phpstan analyse --memory-limit=1G",
        "stil": "phpcs",
        "stil:duzelt": "phpcbf"
    },
    "config": {
        "sort-packages": true
    }
}
